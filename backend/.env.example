# Backend Environment Variables
# Copy this file to .env and fill in real values

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_HOST=postgres
DB_PORT=5432
DB_NAME=videoplatform
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_SSL=false

# JWT Authentication (REQUIRED - app won't start without these)
JWT_SECRET=generate_a_strong_random_string_here
JWT_REFRESH_SECRET=generate_another_strong_random_string_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=http://localhost:8081

# API Keys for external integrations (comma-separated)
# Used by: /api/v1/vendor-integrations/*, /api/v1/vendor-integrations/*/*
# Example: API_KEYS=key1_prod_abc123,key2_vendor_xyz789
API_KEYS=

# File Upload Security
# Max file size in bytes (default: 500MB)
MAX_FILE_SIZE=524288000
