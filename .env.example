# ==============================================================================
# PROPRIETARY VIDEO PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure local values before starting the application.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=videoplatform_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/videoplatform_db

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_encryption_key_2026
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# File Upload Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500
ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska

# CORS Configuration
CORS_ORIGIN=http://localhost:8081,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
